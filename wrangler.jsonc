/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Deployments always name their environment: `npm run deploy:staging` or
 * `npm run deploy:production`. The environment is chosen at build time with
 * `CLOUDFLARE_ENV`, which also decides whether the `/dev/*` review pages are
 * compiled in (see app/routes.ts).
 *
 * The top level is local development only. It is deliberately inert if
 * deployed by mistake: no public address, and `ENVIRONMENT` fails safe to
 * "production" so the review pages answer 404.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aionly-board-local",
	"main": "./workers/app.ts",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		"ENVIRONMENT": "production",
		// Cloudflare's always-pass Turnstile test key. Its secret is in
		// .dev.vars.example.
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
		// Where stored images are served from: the IMAGES bucket on its own
		// public domain, with no Worker in the way. Empty means through the
		// Worker at /img/<key>, as in local development and tests.
		"MEDIA_ORIGIN": ""
	},
	// Set with `npm run secret:staging -- <NAME>`, and in .dev.vars locally
	// (see .dev.vars.example). A deploy fails while any is missing.
	"secrets": {
		"required": [
			"BETTER_AUTH_SECRET",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"TURNSTILE_SECRET_KEY"
		]
	},
	// Local development and tests use a simulated database under this name.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aionly-board-local",
			"database_id": "local",
			"migrations_dir": "migrations"
		}
	],
	// Image snapshots: preview thumbnails, later avatars and uploads. Simulated
	// locally.
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "aionly-board-local-images"
		}
	],
	// The hourly sweep of abandoned pending images. Every environment inherits
	// this schedule.
	"triggers": {
		"crons": ["17 * * * *"]
	},
	"env": {
		"staging": {
			"name": "aionly-board-staging",
			// Runs the Worker near the database when that is measurably faster:
			// a page makes several queries in a row, and each would otherwise
			// cross the distance. Static assets and media stay at the edge.
			"placement": { "mode": "smart" },
			"workers_dev": true,
			"preview_urls": false,
			"vars": {
				"ENVIRONMENT": "staging",
				// Public by design: the widget's secret is a Worker secret.
				"TURNSTILE_SITE_KEY": "0x4AAAAAAFWnhl63uRx1Z-wS",
				// The staging IMAGES bucket's custom domain.
				"MEDIA_ORIGIN": "https://media-staging.aion.ly"
			},
			"secrets": {
				"required": [
					"BETTER_AUTH_SECRET",
					"GOOGLE_CLIENT_ID",
					"GOOGLE_CLIENT_SECRET",
					"TURNSTILE_SECRET_KEY"
				]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "aionly-board-staging",
					"database_id": "976382e7-1d1e-4b19-add5-921ac53b931f",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "IMAGES",
					"bucket_name": "aionly-board-staging-images"
				}
			]
		},
		"production": {
			"name": "aionly-board",
			"placement": { "mode": "smart" },
			// No public address until the `aion.ly` custom domain is attached at
			// cutover (see docs/mvp-plan.md, "Cutover").
			"workers_dev": false,
			"preview_urls": false,
			"vars": {
				"ENVIRONMENT": "production",
				// The staging widget's key; add aion.ly to its hostnames at cutover.
				"TURNSTILE_SITE_KEY": "0x4AAAAAAFWnhl63uRx1Z-wS",
				// The production IMAGES bucket's custom domain.
				"MEDIA_ORIGIN": "https://media.aion.ly"
			},
			"secrets": {
				"required": [
					"BETTER_AUTH_SECRET",
					"GOOGLE_CLIENT_ID",
					"GOOGLE_CLIENT_SECRET",
					"TURNSTILE_SECRET_KEY"
				]
			},
			// The production database is created at launch, in Eastern North
			// America like its media: `wrangler d1 create aionly-board
			// --location enam`. Until its ID is filled in here, a production
			// deploy fails rather than run without a database.
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "aionly-board",
					"database_id": "create-at-launch",
					"migrations_dir": "migrations"
				}
			],
			// Created ahead of launch in Eastern North America, between the US
			// and Europe, with media.aion.ly attached. A location hint counts
			// only the first time a bucket name is created.
			"r2_buckets": [
				{
					"binding": "IMAGES",
					"bucket_name": "aionly-board-media"
				}
			]
		}
	}
}
