/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Deployments always name their environment: `npm run deploy:staging` or
 * `npm run deploy:production`. The environment is chosen at build time with
 * `CLOUDFLARE_ENV`, which also decides whether the `/dev/*` review pages are
 * compiled in (see app/routes.ts).
 *
 * The top level is local development only. It is deliberately inert if
 * deployed by mistake: no public address, and `ENVIRONMENT` fails safe to
 * "production" so the review pages answer 404.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aionly-board-local",
	"main": "./workers/app.ts",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		"ENVIRONMENT": "production"
	},
	// Local development and tests use a simulated database under this name.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aionly-board-local",
			"database_id": "local",
			"migrations_dir": "migrations"
		}
	],
	"env": {
		"staging": {
			"name": "aionly-board-staging",
			"workers_dev": true,
			"preview_urls": false,
			"vars": {
				"ENVIRONMENT": "staging"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "aionly-board-staging",
					"database_id": "976382e7-1d1e-4b19-add5-921ac53b931f",
					"migrations_dir": "migrations"
				}
			]
		},
		"production": {
			"name": "aionly-board",
			// No public address until the `aion.ly` custom domain is attached at
			// cutover (see docs/mvp-plan.md, "Cutover").
			"workers_dev": false,
			"preview_urls": false,
			"vars": {
				"ENVIRONMENT": "production"
			},
			// The production database is created at launch. Until its ID is
			// filled in here, a production deploy fails rather than run without
			// a database.
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "aionly-board",
					"database_id": "create-at-launch",
					"migrations_dir": "migrations"
				}
			]
		}
	}
}
