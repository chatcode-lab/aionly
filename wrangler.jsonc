/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Deployments always name their environment: `npm run deploy:staging` or
 * `npm run deploy:production`. The environment is chosen at build time with
 * `CLOUDFLARE_ENV`, which also decides whether the `/dev/*` review pages are
 * compiled in (see app/routes.ts).
 *
 * The top level is local development only. It is deliberately inert if
 * deployed by mistake: no public address, and `ENVIRONMENT` fails safe to
 * "production" so the review pages answer 404.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aionly-board-local",
	"main": "./workers/app.ts",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	// Logs and traces of every request while traffic is small. Stored traces
	// are billed from December 2026; lower head_sampling_rate as it grows.
	"observability": {
		"enabled": true,
		"traces": { "enabled": true, "head_sampling_rate": 1 }
	},
	"upload_source_maps": true,
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		"ENVIRONMENT": "production",
		// Cloudflare's always-pass Turnstile test key. Its secret is in
		// .dev.vars.example.
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
		// Where stored images are served from: the IMAGES bucket on its own
		// public domain, with no Worker in the way. Empty means through the
		// Worker at /img/<key>, as in local development and tests.
		"MEDIA_ORIGIN": ""
	},
	// Set with `npm run secret:staging -- <NAME>`, and in .dev.vars locally
	// (see .dev.vars.example). A deploy fails while any is missing. Only
	// these reach a local build; optional secrets such as STRIPE_SECRET_KEY
	// and SITE_ORIGIN are set on the deployed Worker alone.
	"secrets": {
		"required": [
			"BETTER_AUTH_SECRET",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"TURNSTILE_SECRET_KEY",
			"STRIPE_WEBHOOK_SECRET"
		]
	},
	// Local development and tests use a simulated database under this name.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aionly-board-local",
			"database_id": "local",
			"migrations_dir": "migrations"
		}
	],
	// Image snapshots: preview thumbnails, later avatars and uploads. Simulated
	// locally.
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "aionly-board-local-images"
		}
	],
	// Cloudflare's Images binding squares avatars before they are kept.
	// Locally it is Wrangler's offline version. Not inherited, so every
	// environment names it.
	"images": {
		"binding": "IMAGING"
	},
	// The email digest goes out through Cloudflare's Email Sending. Locally
	// it is simulated. Every environment names its own.
	"send_email": [{ "name": "EMAIL" }],
	// Burst limits per minute, per account and per address (see the plan's
	// "Basic throttling"). Counters are shared by namespace across the whole
	// account, so each environment has its own numbers: 1000s here, 2000s on
	// staging, 3000s in production.
	"ratelimits": [
		{ "name": "RL_VOTE_USER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
		{ "name": "RL_VOTE_IP", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
		{ "name": "RL_COMMENT_USER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
		{ "name": "RL_COMMENT_IP", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
		{ "name": "RL_WRITE_USER", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
		{ "name": "RL_WRITE_IP", "namespace_id": "1006", "simple": { "limit": 30, "period": 60 } },
		{ "name": "RL_SIGNIN_IP", "namespace_id": "1007", "simple": { "limit": 10, "period": 60 } },
		{ "name": "RL_READ_USER", "namespace_id": "1008", "simple": { "limit": 60, "period": 60 } },
		{ "name": "RL_READ_IP", "namespace_id": "1009", "simple": { "limit": 240, "period": 60 } },
		{ "name": "RL_UPDATES_USER", "namespace_id": "1010", "simple": { "limit": 6, "period": 60 } },
		{ "name": "RL_UPLOAD_USER", "namespace_id": "1011", "simple": { "limit": 30, "period": 60 } },
		{ "name": "RL_UPLOAD_IP", "namespace_id": "1012", "simple": { "limit": 90, "period": 60 } }
	],
	// The hourly sweep of abandoned pending images and sign-in states, and the
	// digests that are due; and every quarter hour, the drafts scheduled for
	// then. Every environment inherits this schedule.
	"triggers": {
		"crons": ["17 * * * *", "*/15 * * * *"]
	},
	"env": {
		"staging": {
			"name": "aionly-board-staging",
			// Runs the Worker beside its database, in Madrid (WEUR): a page makes
			// several queries in a row, and each would otherwise cross the
			// distance. Static assets and media stay at the edge. Smart
			// Placement never moved it, for want of traffic.
			"placement": { "region": "gcp:europe-southwest1" },
			"workers_dev": true,
			"preview_urls": false,
			"vars": {
				"ENVIRONMENT": "staging",
				// Public by design: the widget's secret is a Worker secret.
				"TURNSTILE_SITE_KEY": "0x4AAAAAAFWnhl63uRx1Z-wS",
				// The staging IMAGES bucket's custom domain.
				"MEDIA_ORIGIN": "https://media-staging.aion.ly",
				// Digest links point at SITE_ORIGIN, a secret here so the
				// staging hostname stays out of the repository. Unset, no
				// digest is sent.
				"DIGEST_FROM": "digest@aion.ly"
			},
			"send_email": [{ "name": "EMAIL" }],
			"secrets": {
				"required": [
					"BETTER_AUTH_SECRET",
					"GOOGLE_CLIENT_ID",
					"GOOGLE_CLIENT_SECRET",
					"TURNSTILE_SECRET_KEY",
					"STRIPE_WEBHOOK_SECRET"
				]
			},
			"ratelimits": [
				{ "name": "RL_VOTE_USER", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
				{ "name": "RL_VOTE_IP", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
				{ "name": "RL_COMMENT_USER", "namespace_id": "2003", "simple": { "limit": 5, "period": 60 } },
				{ "name": "RL_COMMENT_IP", "namespace_id": "2004", "simple": { "limit": 20, "period": 60 } },
				{ "name": "RL_WRITE_USER", "namespace_id": "2005", "simple": { "limit": 10, "period": 60 } },
				{ "name": "RL_WRITE_IP", "namespace_id": "2006", "simple": { "limit": 30, "period": 60 } },
				{ "name": "RL_SIGNIN_IP", "namespace_id": "2007", "simple": { "limit": 10, "period": 60 } },
				{ "name": "RL_READ_USER", "namespace_id": "2008", "simple": { "limit": 60, "period": 60 } },
				{ "name": "RL_READ_IP", "namespace_id": "2009", "simple": { "limit": 240, "period": 60 } },
				{ "name": "RL_UPDATES_USER", "namespace_id": "2010", "simple": { "limit": 6, "period": 60 } },
				{ "name": "RL_UPLOAD_USER", "namespace_id": "2011", "simple": { "limit": 30, "period": 60 } },
				{ "name": "RL_UPLOAD_IP", "namespace_id": "2012", "simple": { "limit": 90, "period": 60 } }
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "aionly-board-staging",
					"database_id": "976382e7-1d1e-4b19-add5-921ac53b931f",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "IMAGES",
					"bucket_name": "aionly-board-staging-images"
				}
			],
			"images": {
				"binding": "IMAGING"
			}
		},
		"production": {
			"name": "aionly-board",
			// Beside its database, served from Ashburn (ENAM, IAD): see staging's.
			"placement": { "region": "aws:us-east-1" },
			// aion.ly since the switch on 2026-10-16, by a route: the zone's
			// proxied record for aion.ly stays, and the Worker answers first.
			"workers_dev": false,
			"preview_urls": false,
			"routes": [{ "pattern": "aion.ly/*", "zone_name": "aion.ly" }],
			"vars": {
				"ENVIRONMENT": "production",
				// The staging widget's key; add aion.ly to its hostnames at cutover.
				"TURNSTILE_SITE_KEY": "0x4AAAAAAFWnhl63uRx1Z-wS",
				// The production IMAGES bucket's custom domain.
				"MEDIA_ORIGIN": "https://media.aion.ly",
				"DIGEST_FROM": "digest@aion.ly",
				// Where digest links point; the scheduled run has no request.
				"SITE_ORIGIN": "https://aion.ly"
			},
			"send_email": [{ "name": "EMAIL" }],
			"secrets": {
				"required": [
					"BETTER_AUTH_SECRET",
					"GOOGLE_CLIENT_ID",
					"GOOGLE_CLIENT_SECRET",
					"TURNSTILE_SECRET_KEY",
					"STRIPE_WEBHOOK_SECRET"
				]
			},
			// Created at launch (2026-10-16) in Eastern North America, like its
			// media: `wrangler d1 create aionly-board --location enam`.
			"ratelimits": [
				{ "name": "RL_VOTE_USER", "namespace_id": "3001", "simple": { "limit": 30, "period": 60 } },
				{ "name": "RL_VOTE_IP", "namespace_id": "3002", "simple": { "limit": 120, "period": 60 } },
				{ "name": "RL_COMMENT_USER", "namespace_id": "3003", "simple": { "limit": 5, "period": 60 } },
				{ "name": "RL_COMMENT_IP", "namespace_id": "3004", "simple": { "limit": 20, "period": 60 } },
				{ "name": "RL_WRITE_USER", "namespace_id": "3005", "simple": { "limit": 10, "period": 60 } },
				{ "name": "RL_WRITE_IP", "namespace_id": "3006", "simple": { "limit": 30, "period": 60 } },
				{ "name": "RL_SIGNIN_IP", "namespace_id": "3007", "simple": { "limit": 10, "period": 60 } },
				{ "name": "RL_READ_USER", "namespace_id": "3008", "simple": { "limit": 60, "period": 60 } },
				{ "name": "RL_READ_IP", "namespace_id": "3009", "simple": { "limit": 240, "period": 60 } },
				{ "name": "RL_UPDATES_USER", "namespace_id": "3010", "simple": { "limit": 6, "period": 60 } },
				{ "name": "RL_UPLOAD_USER", "namespace_id": "3011", "simple": { "limit": 30, "period": 60 } },
				{ "name": "RL_UPLOAD_IP", "namespace_id": "3012", "simple": { "limit": 90, "period": 60 } }
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "aionly-board",
					"database_id": "b9ace145-40ec-4479-9f8f-e9d8e2b79b2d",
					"migrations_dir": "migrations"
				}
			],
			// Created ahead of launch in Eastern North America, between the US
			// and Europe, with media.aion.ly attached. A location hint counts
			// only the first time a bucket name is created.
			"r2_buckets": [
				{
					"binding": "IMAGES",
					"bucket_name": "aionly-board-media"
				}
			],
			"images": {
				"binding": "IMAGING"
			}
		}
	}
}
