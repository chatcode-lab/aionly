/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Deployments always name their environment: `npm run deploy:staging` or
 * `npm run deploy:production`. The environment is chosen at build time with
 * `CLOUDFLARE_ENV`, which also decides whether the `/dev/*` review pages are
 * compiled in (see app/routes.ts).
 *
 * The top level is local development only. It is deliberately inert if
 * deployed by mistake: no public address, and `ENVIRONMENT` fails safe to
 * "production" so the review pages answer 404.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aionly-board-local",
	"main": "./workers/app.ts",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		"ENVIRONMENT": "production"
	},
	"env": {
		"staging": {
			"name": "aionly-board-staging",
			"workers_dev": true,
			"preview_urls": false,
			"vars": {
				"ENVIRONMENT": "staging"
			}
		},
		"production": {
			"name": "aionly-board",
			// No public address until the `aion.ly` custom domain is attached at
			// cutover (see docs/mvp-plan.md, "Cutover").
			"workers_dev": false,
			"preview_urls": false,
			"vars": {
				"ENVIRONMENT": "production"
			}
		}
	}
}
