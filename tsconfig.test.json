{
  "extends": "./tsconfig.json",
  "include": [
    "app/**/*.test.ts",
    "app/lib/**/*.ts"
  ],
  "exclude": [
    "app/**/*.server.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": [
      "node"
    ],
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "~/*": [
        "./app/*"
      ]
    }
  }
}
